; Engine configuration file.
; It's best edited using the editor UI.

config_version=5

[application]

config/name="Ping Pong Paddle"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray()
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/content_scale_mode=4
window/size/content_scale_aspect=1
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input]

paddle_left_up={
"deadzone": 0.5,
"events": [ { "type": "InputEventKey", "physical_keycode": 87, "keycode": 87, "unicode": 0, "echo": false, "pressed": true } ]
}
paddle_left_down={
"deadzone": 0.5,
"events": [ { "type": "InputEventKey", "physical_keycode": 83, "keycode": 83, "unicode": 0, "echo": false, "pressed": true } ]
}
paddle_right_up={
"deadzone": 0.5,
"events": [ { "type": "InputEventKey", "physical_keycode": 16777232, "keycode": 4194320, "unicode": 0, "echo": false, "pressed": true } ]
}
paddle_right_down={
"deadzone": 0.5,
"events": [ { "type": "InputEventKey", "physical_keycode": 16777234, "keycode": 4194322, "unicode": 0, "echo": false, "pressed": true } ]
}
serve_ball={
"deadzone": 0.5,
"events": [ { "type": "InputEventKey", "physical_keycode": 32, "keycode": 32, "unicode": 0, "echo": false, "pressed": true } ]
}
restart_game={
"deadzone": 0.5,
"events": [ { "type": "InputEventKey", "physical_keycode": 82, "keycode": 82, "unicode": 0, "echo": false, "pressed": true } ]
}

[rendering]

environment/default_environment="res://default_env.tres"
